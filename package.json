{
  "name": "changereel",
  "version": "0.8.1",
  "description": "Find what a change did to the pages of a site and show it as a before and after video.",
  "keywords": [
    "visual-regression",
    "screenshot",
    "diff",
    "video",
    "pull-request",
    "github-action",
    "remotion",
    "changelog",
    "review"
  ],
  "homepage": "https://github.com/derblub/changereel#readme",
  "bugs": "https://github.com/derblub/changereel/issues",
  "type": "module",
  "bin": {
    "changereel": "src/cli.mjs"
  },
  "files": [
    "src",
    "video",
    "schema"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "diff": "^9.0.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.535"
  },
  "author": "Daniel Kurdoghlian, Pushing Pixels (https://pushingpixels.at)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derblub/changereel.git"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
